{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dev dependencies",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-e", ".[dev]"],
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Audit this portfolio",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "repo_health_auditor.cli", "Videirafo/Fernando_Videira"],
      "problemMatcher": []
    }
  ]
}
